# Server-only secret. Never expose this value to the browser or commit a real .env file.
SIGN_SEED=

# Provided by the managed database or your Vercel database provider.
DATABASE_URL=

# FLOP Devnet read-only connection (optional overrides)
FLOP_RPC_HTTP=https://rpc.devnet.flop.network
FLOP_RPC_WSS=wss://rpc.devnet.flop.network
FLOP_GATEWAY_URL=https://api.flop.network
